{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://flowstate.local/schemas/protocol/v1",
  "title": "ProtocolRecord",
  "description": "Phase 0 shared records. The Event envelope is versioned independently for transport compatibility.",
  "oneOf": [
    {
      "$ref": "#/definitions/Agent"
    },
    {
      "$ref": "#/definitions/Task"
    },
    {
      "$ref": "#/definitions/Run"
    },
    {
      "$ref": "#/definitions/Tool"
    },
    {
      "$ref": "#/definitions/Skill"
    },
    {
      "$ref": "#/definitions/Workflow"
    },
    {
      "$ref": "#/definitions/Artifact"
    },
    {
      "$ref": "#/definitions/Event"
    },
    {
      "$ref": "#/definitions/Model"
    },
    {
      "$ref": "#/definitions/Permission"
    },
    {
      "$ref": "#/definitions/Memory"
    },
    {
      "$ref": "#/definitions/Device"
    }
  ],
  "definitions": {
    "Agent": {
      "title": "Agent",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "instructions": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "createdAt",
        "updatedAt",
        "name",
        "instructions"
      ]
    },
    "Task": {
      "title": "Task",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "running",
            "completed",
            "failed",
            "canceled"
          ]
        },
        "agentId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "createdAt",
        "updatedAt",
        "title",
        "status"
      ]
    },
    "Run": {
      "title": "Run",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "taskId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "running",
            "completed",
            "failed",
            "canceled"
          ]
        }
      },
      "required": [
        "id",
        "createdAt",
        "updatedAt",
        "taskId",
        "status"
      ]
    },
    "Tool": {
      "title": "Tool",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "riskClass": {
          "type": "string",
          "enum": [
            "READ",
            "WRITE",
            "EXECUTE",
            "EXTERNAL",
            "DESTRUCTIVE",
            "SENSITIVE",
            "FINANCIAL"
          ]
        }
      },
      "required": [
        "id",
        "createdAt",
        "updatedAt",
        "name",
        "riskClass"
      ]
    },
    "Skill": {
      "title": "Skill",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "createdAt",
        "updatedAt",
        "name",
        "version"
      ]
    },
    "Workflow": {
      "title": "Workflow",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "createdAt",
        "updatedAt",
        "name"
      ]
    },
    "Artifact": {
      "title": "Artifact",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "createdAt",
        "updatedAt",
        "runId",
        "kind",
        "uri"
      ]
    },
    "Event": {
      "title": "Event",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "task.started",
            "task.completed",
            "task.failed",
            "agent.started",
            "agent.message",
            "model.started",
            "model.delta",
            "model.completed",
            "tool.started",
            "tool.output",
            "tool.completed",
            "permission.requested",
            "permission.resolved",
            "workflow.started",
            "workflow.failed",
            "artifact.created",
            "terminal.output",
            "computer.state",
            "file.changed"
          ]
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "payload": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "schemaVersion",
        "type",
        "occurredAt",
        "payload"
      ]
    },
    "Model": {
      "title": "Model",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "createdAt",
        "updatedAt",
        "provider",
        "name",
        "capabilities"
      ]
    },
    "Permission": {
      "title": "Permission",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "subjectId": {
          "type": "string",
          "minLength": 1
        },
        "toolId": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "type": "string",
          "enum": [
            "allow",
            "ask",
            "deny"
          ]
        },
        "riskClass": {
          "$ref": "#/definitions/RiskClass"
        }
      },
      "required": [
        "id",
        "createdAt",
        "updatedAt",
        "subjectId",
        "toolId",
        "decision",
        "riskClass"
      ]
    },
    "Memory": {
      "title": "Memory",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "scope": {
          "type": "string",
          "enum": [
            "private",
            "project",
            "shared"
          ]
        },
        "content": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "createdAt",
        "updatedAt",
        "scope",
        "content"
      ]
    },
    "Device": {
      "title": "Device",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "enum": [
            "macos",
            "ios",
            "windows",
            "linux",
            "android",
            "web"
          ]
        }
      },
      "required": [
        "id",
        "createdAt",
        "updatedAt",
        "name",
        "platform"
      ]
    },
    "RiskClass": {
      "title": "RiskClass",
      "type": "string",
      "enum": [
        "READ",
        "WRITE",
        "EXECUTE",
        "EXTERNAL",
        "DESTRUCTIVE",
        "SENSITIVE",
        "FINANCIAL"
      ]
    }
  }
}
