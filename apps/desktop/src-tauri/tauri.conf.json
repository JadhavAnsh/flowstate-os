{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlowState OS",
  "version": "0.1.0",
  "identifier": "com.flowstate.os",
  "build": {
    "beforeDevCommand": "bun run build:native && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun ../../scripts/unlock-flowstate-signing.mjs && bun run build:native && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "FlowState OS",
        "width": 1180,
        "height": 780,
        "minWidth": 760,
        "minHeight": 620
      },
      {
        "label": "hud",
        "title": "FlowState HUD",
        "width": 660,
        "height": 380,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "center": false,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/flowstate-apple-runtime"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist",
      "signingIdentity": "FlowState OS Local Build Signing"
    }
  }
}
