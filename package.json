{
  "name": "flowstate-os",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "bun --cwd apps/web dev",
    "dev:api": "bun --cwd apps/api dev",
    "dev:desktop": "bun --cwd apps/desktop tauri dev",
    "build:web": "bun --cwd apps/web build",
    "build:desktop": "bun --cwd apps/desktop build",
    "generate:protocol": "bun --cwd packages/protocol generate",
    "check:protocol": "bun --cwd packages/protocol check",
    "test:protocol": "bun --cwd packages/protocol test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "precommit": "lint-staged && bun --cwd apps/web lint && bun run typecheck",
    "typecheck": "bun --cwd apps/web typecheck && bun --cwd apps/api typecheck && bun --cwd apps/desktop typecheck && bun --cwd packages/protocol typecheck",
    "check": "bun run check:protocol && bun run test:protocol && bun run typecheck && cargo check --workspace && cargo test -p flowstate-protocol"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,css,md,html,yaml,yml}": "prettier --write"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.9.6"
  }
}
